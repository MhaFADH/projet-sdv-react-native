    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
