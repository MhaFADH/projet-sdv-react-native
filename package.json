    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^26.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "react-native": "0.81.5",
